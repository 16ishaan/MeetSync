# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Supabase credentials (required for auth + cloud storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend transcription server URL (defaults to http://127.0.0.1:8000 if not set)
VITE_TRANSCRIPTION_API_URL=http://127.0.0.1:8000

# ── Backend (transcription_server.py) ─────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large-v2
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# AI provider for MoM generation (REQUIRED for Generate MoM feature)
# Supported: openai | anthropic | google
AI_PROVIDER=openai
# Your API key for the chosen provider (NEVER put in VITE_ variables)
AI_API_KEY=your-ai-api-key-here
# Model to use (optional — defaults: gpt-4o-mini for OpenAI, claude-3-haiku for Anthropic, gemini-1.5-flash for Google)
AI_MODEL=gpt-4o-mini

# CORS origins allowed to call the backend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Supabase auth (configure in Supabase dashboard) ───────────────────────────
# Add your app URL to Supabase Auth > Redirect URLs:
# http://localhost:5173
# http://localhost:5173/
# http://127.0.0.1:5173

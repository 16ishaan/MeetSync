VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: if you want Google auth to work in the browser,
# add your app URL to Supabase Auth > Redirect URLs:
# http://localhost:5173
# http://localhost:5173/
# http://127.0.0.1:5173

VITE_TRANSCRIPTION_API_URL=http://127.0.0.1:8000

# Optional: true to try the AI backend; browser-only mode is the default.
VITE_MOM_USE_BACKEND=false
